{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true
    },
    "logs": {
        "text": "data/infection.log"
    },
    // Set to the measured baseline, not an aspirational number.
    // If a change drops these, add a test — do not lower the threshold.
    "minMsi": 87,
    "minCoveredMsi": 87,
    "timeout": 30
}
